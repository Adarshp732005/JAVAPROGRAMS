package com.adarshjava;

public class vedio33 {
    static int sum(int...arr) {
        int result = 0;
       for(int i=0; i<arr.length; i++){
           result += arr[i];
       }
       return result;
    }
    public static void main(String[] args){

        System.out.println("the sum of arrr = "+sum( 5,6));
    }
}

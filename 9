class Rectangle9{
    private int length;
    private int breath;

    public Rectangle9() {
        this.length = 4;
        this.breath = 5;
    }

    public Rectangle9(int length, int breath) {
        this.length = length;
        this.breath = breath;
    }

    public int getLength() {
        return length;
    }

    public int getBreath() {
        return breath;
    }
}

package com.adarshjava;
class Base89 {
    public int x;
//inheritace ka program he esme base class ki properties derived class me use kar skte hai hai
    //do class banai hai base or derived derived class base class ko use kr skta hai pr base class
    //derived class ko use nhi kr skta base class mtlb parent class and derived class means child class

    public int getX() {
        return x;
    }

    public void setX(int x) {
        System.out.println("this is a vlue of x");
        this.x = x;
    }
}

    class Derived98 extends Base89 {
        public int y;

        public int getY() {
            return y;
        }

        public void setY(int y) {
            System.out.println("this value is y");
            this.y = y;
        }
    }

